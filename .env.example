# Copy to .env and fill in. Used by docker compose and by `npm run start:dev`.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Seed script (npm run seed): bcrypt salt rounds, i.e. the hashing cost (4-31).
# bcrypt adds a fresh random salt to every hash; higher is slower and stronger.
BCRYPT_SALT_ROUNDS=10
APP_PORT=3000
# Frontend (nginx): http://localhost:8080
WEB_PORT=8080

# Running the app locally (npm run start:dev) against the compose Mongo:
#   docker compose up -d mongo
# The default URI below already matches the published port, so this line is
# only needed if you change MONGO_PORT or use another MongoDB.
# MONGODB_URI=mongodb://localhost:27017/care-guide
# Careful: docker compose reads this same file and passes MONGODB_URI (and the
# OTEL_* / TRUST_PROXY values below) to the app container, so a localhost value
# set here would break the containerised app. Leave them unset when using Docker.
# MONGO_PORT=27017

# Tracing (OpenTelemetry -> Tempo, viewed in Grafana: Explore > Tempo).
# `docker compose up -d tempo` + `npm run start:dev` exports to localhost:4318 by default.
# OTEL_SDK_DISABLED=true            # turn tracing and metrics off
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTLP_PORT=4318

# Latency monitoring (OpenTelemetry metrics -> Prometheus -> Grafana).
# Grafana: http://localhost:3001 (dashboard "API latency"), Prometheus: http://localhost:9090
# GRAFANA_ADMIN_PASSWORD=admin      # change if the machine is shared
# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090
# OTEL_EXPORTER_PROMETHEUS_PORT=9464   # app's /metrics port (scraped inside the compose network)
