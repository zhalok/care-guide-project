{
  "uid": "care-guide-api-traces",
  "title": "API traces",
  "tags": [
    "care-guide",
    "tracing"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "API latency",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/care-guide-api-latency",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "traceId",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "description": "Paste a trace ID, or click one in the tables above."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Click a **trace ID** in a table to load it in the waterfall below. Each row is a span: the HTTP request at the top, then the **controller \u2192 service \u2192 repository** layers (tag `app.layer`), then the Mongoose and MongoDB calls. Bar length is duration."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Recent requests",
      "description": "Latest request traces. Click a trace ID to open its span waterfall.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"care-guide-api\" && kind = server }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace waterfall",
                    "url": "/d/care-guide-api-traces?var-traceId=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Slow requests (> 100 ms)",
      "description": "Request traces slower than 100 ms.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"care-guide-api\" && kind = server && duration > 100ms }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace waterfall",
                    "url": "/d/care-guide-api-traces?var-traceId=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 4,
      "type": "traces",
      "title": "Trace waterfall",
      "description": "Spans of the trace selected above (or typed into the Trace ID box).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceId",
          "query": "${traceId}"
        }
      ]
    }
  ]
}
